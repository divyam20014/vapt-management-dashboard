# Copy to backend/.env (or the repository root .env) and adjust as needed.
# Relative paths are resolved against the repository root, so the backend
# behaves the same whether it is started from the repo root or from backend/.

DATABASE_URL=sqlite:///./data/vapt.db
UPLOAD_DIRECTORY=./data/uploads
EXPORT_DIRECTORY=./exports
MAX_UPLOAD_SIZE_MB=50

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

LOG_LEVEL=INFO

# Sign-in sessions end after SESSION_IDLE_MINUTES without activity, and always after SESSION_MAX_HOURS.
SESSION_IDLE_MINUTES=480
SESSION_MAX_HOURS=24
# Set to true when the application is served over HTTPS.
SESSION_COOKIE_SECURE=false

# SQLite write-ahead logging (reads continue during large uploads). Set to false on network shares.
SQLITE_WAL=true
SQLITE_BUSY_TIMEOUT_SECONDS=30
